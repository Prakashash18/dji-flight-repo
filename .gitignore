# Environment configurations (Secrets & Credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Python virtual environments & dependencies
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
processing_station/venv/
processing_station/.venv/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# Node modules and dependency trees
node_modules/
mobile/node_modules/

# Mobile expo build and runtime files
.expo/
mobile/.expo/
mobile/dist/

# OS metadata
.DS_Store
Thumbs.db

# Downloaded model weights cache and temporary upload staging
backend/model_cache/
backend/temp_uploads/

# Large media files (videos, models etc. over 100MB)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.zip
*.tar.gz


# Model weights (large, installed per-machine)
backend/models/

# Regenerated on demand — annotated frames, map tiles and detection crops are
# all rebuilt from the source data, so they are machine state, not source.
backend/frame_cache/
backend/tile_cache/
backend/crop_cache/

# Runtime and debugging leftovers
deploy/logs/
backend/live_tail.json
scratch/
